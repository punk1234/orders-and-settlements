PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orders_and_settlements?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
# Optional: powers the "Ask about your orders" assistant (stretch feature).
# Everything else works fine with this unset — the endpoint just returns a
# clear 503 instead of crashing the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
